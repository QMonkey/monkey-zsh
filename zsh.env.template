# ~/.config/env/zsh.env — environment for zsh (monkey-zsh).
# The profiles source this file with `set -a`, so everything here reaches zsh
# and every process zsh starts. Add your own zsh-scoped variables anywhere in
# it: install.sh only touches the keys it seeds below (render_fill passes any
# other line through untouched), and a value already in the file always wins
# over the install-time environment (fill-empty), so hand edits survive
# re-runs. install.sh renders this template to the real file (0600) from the
# variables exported BEFORE the install ran, and writes the file and the
# profile line that sources it on every run — even when nothing was exported,
# where every key lands empty. The file is the hand-fill entry point, not a
# snapshot of one install, and it is independent of any other project's
# credential store.
#
# Empty means UNSET. The provider variables are safe on their own:
# smart-suggestion tests each of them against "" and falls back to its own
# endpoint default, so an empty line cannot build a half-configured URL.
# Defaults live in the comments only: a default written here would beat the
# install-time environment (render_fill treats any non-empty line as an
# already-set value).
#
# The provider set above is what the plugin reads, and nothing else is seeded
# on its behalf. The proxy trio at the bottom is the deliberate exception: it
# is not a smart-suggestion setting but the environment that binary inherits
# when it dials the gateway, and with a proxy exported and no NO_PROXY entry
# for loopback, a local endpoint (Ollama on 127.0.0.1) gets routed through
# that proxy too — which is why NO_PROXY lands with the loopback binds already
# merged in. The rule itself is unchanged: where a key IS part of a project's
# surface, the machine-specific part is the VALUE — the key ships as an empty
# line to fill in, never with this host's answer baked in.
#
# Values are written bare; whitespace/quotes get auto-quoted on write.
# Keep this file free of newlines inside values — a newline breaks every
# KEY= line below it.

# ── smart-suggestion: provider switch ──
# openai | azure_openai | anthropic | gemini | deepseek. Empty = the plugin
# picks the first provider whose API key is non-empty, in that order.
SMART_SUGGESTION_AI_PROVIDER=

# ── openai (needs OPENAI_API_KEY; its request model is fixed upstream) ──
# OPENAI_BASE_URL is the prefix; /v1/chat/completions is appended, so a
# compatible gateway gets its hostname here and nothing more.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ── anthropic (needs ANTHROPIC_API_KEY) ──
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# ── gemini (needs GEMINI_API_KEY; GEMINI_MODEL overrides the default) ──
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=

# ── deepseek (needs DEEPSEEK_API_KEY; DEEPSEEK_MODEL overrides the default) ──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# ── azure_openai (needs API_KEY + DEPLOYMENT_NAME; RESOURCE_NAME only when
# AZURE_OPENAI_BASE_URL is left empty) ──
# AZURE_OPENAI_BASE_URL replaces the <resource>.openai.azure.com hostname
# outright. AZURE_OPENAI_API_VERSION has a plugin-side default, so it only
# needs a value to move off that version.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_RESOURCE_NAME=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_VERSION=

# ── proxy ──
# The family-wide trio, named once in scripts/lib/env.sh (PROXY_ENV_KEYS) with
# the measured detail of which reader honours which spelling — read that
# before adding a fourth. smart-suggestion is a Go binary using the default
# HTTP transport, which honours both the uppercase and lowercase forms, so
# these three lines are enough for it; empty = unset.
# They are the host's keys, not the plugin's: the same names may also be
# filled in another project's env file here. render_fill never rewrites a
# non-empty line, so a proxy rotation means editing every file that lists them,
# and an EMPTY line here is not neutral — this file is sourced later, so the
# empty assignment clears the inherited value for the whole zsh subtree.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=
